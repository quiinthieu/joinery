{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Joinery",
  "version": "0.1.0",
  "identifier": "com.quiinthieu.joinery",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "beforeBuildCommand": "pnpm build",
    "devUrl": "http://127.0.0.1:1420",
    "frontendDist": "../dist"
  },
  "app": {
    "withGlobalTauri": false,
    "windows": [{ "label": "main", "title": "Joinery", "width": 1440, "height": 920, "minWidth": 980, "minHeight": 640 }],
    "security": {
      "capabilities": ["main"],
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' asset: http://asset.localhost data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost; worker-src 'self' blob:; object-src 'none'; frame-src 'none'; base-uri 'none'"
    }
  },
  "bundle": { "active": true, "targets": "all", "category": "DeveloperTool", "shortDescription": "A focused database studio", "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"] }
}
