{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "main",
  "description": "The bundled main window may use explicitly enrolled studio commands.",
  "windows": [
    "main"
  ],
  "permissions": [
    "core:default",
    "core:window:allow-destroy",
    "allow-app-info",
    "allow-bootstrap",
    "allow-save-workspace",
    "allow-metadata-backups",
    "allow-create-metadata-backup",
    "allow-restore-metadata-backup",
    "allow-delete-metadata-backup",
    "allow-acknowledge-quit",
    "allow-save-group",
    "allow-delete-group",
    "allow-audit-log",
    "allow-save-profile",
    "allow-delete-profile",
    "allow-connect",
    "allow-disconnect",
    "allow-set-passphrase",
    "allow-prepare-execution",
    "allow-authorize-plan",
    "allow-execute-plan",
    "allow-cancel-run",
    "allow-catalog",
    "allow-database-objects",
    "allow-object-details",
    "allow-completion-catalog",
    "allow-completion-schema",
    "allow-redis-scan",
    "allow-redis-inspect",
    "allow-table-schema",
    "allow-referencing-foreign-keys",
    "allow-prepare-browse-table",
    "allow-browse-table",
    "allow-result-range",
    "allow-release-result",
    "allow-prepare-changes",
    "allow-prepare-changes-batch",
    "allow-prepare-table-changes",
    "allow-processes",
    "allow-prepare-process-cancel",
    "allow-health",
    "allow-history",
    "allow-clear-history",
    "allow-resource-usage",
    "allow-probe-ssh",
    "allow-trust-ssh-key",
    "allow-pick-export-destination",
    "allow-start-export",
    "allow-cancel-export",
    "allow-pick-import-source",
    "allow-preview-csv-import",
    "allow-prepare-csv-import-batch",
    "allow-compare-data"
  ]
}
