# Local manual connection-test inventory. Copy to .env with owner-only access.
# .env is ignored by Git. Never use VITE_ prefixes for secrets.
# These values do not automatically create or populate Joinery profiles.
# Do not source this file as shell code. Keep private-key contents out of it.

JOINERY_TEST_PG_1_LABEL=
JOINERY_TEST_PG_1_HOST=
JOINERY_TEST_PG_1_PORT=5432
JOINERY_TEST_PG_1_DATABASE=
JOINERY_TEST_PG_1_USERNAME=
JOINERY_TEST_PG_1_PASSWORD=
JOINERY_TEST_PG_1_ACCESS=direct
JOINERY_TEST_PG_1_TLS=verify-full
JOINERY_TEST_PG_1_CA_FILE=
JOINERY_TEST_PG_1_APPROVED_SCHEMA=
JOINERY_TEST_PG_1_APPROVED_TABLE=
JOINERY_TEST_PG_1_SSH_HOST=
JOINERY_TEST_PG_1_SSH_PORT=22
JOINERY_TEST_PG_1_SSH_USERNAME=
JOINERY_TEST_PG_1_SSH_AUTH=agent
JOINERY_TEST_PG_1_SSH_AGENT_SOCKET=
JOINERY_TEST_PG_1_SSH_KEY_FILE=
JOINERY_TEST_PG_1_SSH_KEY_PASSPHRASE=
JOINERY_TEST_PG_1_SSH_PASSWORD=
JOINERY_TEST_PG_1_SSH_EXPECTED_FINGERPRINT=

# Duplicate the PG_1 block as PG_2, PG_3, etc. for additional databases.

JOINERY_TEST_SNOWFLAKE_1_LABEL=
JOINERY_TEST_SNOWFLAKE_1_ACCOUNT=
JOINERY_TEST_SNOWFLAKE_1_HOST=
JOINERY_TEST_SNOWFLAKE_1_USERNAME=
JOINERY_TEST_SNOWFLAKE_1_ROLE=
JOINERY_TEST_SNOWFLAKE_1_WAREHOUSE=
JOINERY_TEST_SNOWFLAKE_1_DATABASE=
JOINERY_TEST_SNOWFLAKE_1_SCHEMA=
JOINERY_TEST_SNOWFLAKE_1_AUTH=oauth_authorization_code
JOINERY_TEST_SNOWFLAKE_1_OAUTH_TOKEN=
JOINERY_TEST_SNOWFLAKE_1_PRIVATE_KEY_FILE=
JOINERY_TEST_SNOWFLAKE_1_PRIVATE_KEY_PASSPHRASE=
JOINERY_TEST_SNOWFLAKE_1_ACCESS=direct
JOINERY_TEST_SNOWFLAKE_1_APPROVED_TABLE=

# Browser sign-in uses Snowflake's local-application OAuth flow. Leave the
# OAuth token and private-key fields empty for this authentication method.
# This file is an inventory; the desktop app does not import it.
# Duplicate SNOWFLAKE_1 as SNOWFLAKE_2, etc. for additional accounts/contexts.
