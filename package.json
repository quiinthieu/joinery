{
  "name": "joinery",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.23.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "icons": "tauri icon public/joinery.svg --output src-tauri/icons",
    "dev": "pnpm contracts && pnpm icons && vite --host 127.0.0.1",
    "build": "pnpm contracts && pnpm icons && tsc -b && vite build",
    "check": "pnpm contracts && tsc -b && vitest run",
    "test": "vitest run",
    "tauri": "tauri",
    "desktop": "tauri dev",
    "desktop:build": "tauri build --no-bundle",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --no-default-features",
    "contracts": "cargo run --manifest-path src-tauri/Cargo.toml --no-default-features --features contracts --bin export-contracts",
    "test:e2e": "playwright test",
    "build:smoke": "pnpm contracts && pnpm icons && tsc -b && vite build --mode native-smoke",
    "desktop:smoke:build": "tauri build --no-bundle --features native-smoke --config src-tauri/tauri.smoke.conf.json && node scripts/prepare-native-smoke.mjs",
    "test:native": "python3 scripts/native-smoke.py",
    "format:check": "prettier --check src tests/e2e playwright.config.ts scripts/prepare-native-smoke.mjs",
    "format": "prettier --write src tests/e2e playwright.config.ts scripts/prepare-native-smoke.mjs",
    "desktop:bundle:mac": "tauri build --bundles app"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6",
    "@codemirror/commands": "^6",
    "@codemirror/lang-sql": "^6",
    "@codemirror/language": "^6",
    "@codemirror/search": "^6",
    "@codemirror/state": "^6",
    "@codemirror/view": "^6",
    "@glideapps/glide-data-grid": "6.0.3",
    "@lezer/highlight": "^1.2.5",
    "@tauri-apps/api": "~2.11.1",
    "apache-arrow": "^21.2.0",
    "lodash": "^4.17.21",
    "lucide-react": "^0.468.0",
    "marked": "^4.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-responsive-carousel": "^3.2.23",
    "sql-formatter": "^15.9.0",
    "zustand": "^5"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.0",
    "@tailwindcss/vite": "^4",
    "@tauri-apps/cli": "^2",
    "@testing-library/react": "^16",
    "@types/lodash": "^4.17.0",
    "@types/node": "^24",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@vitejs/plugin-react": "^6",
    "jsdom": "^28",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^6",
    "vite": "^8",
    "vitest": "^4"
  }
}
